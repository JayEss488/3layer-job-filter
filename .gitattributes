# Shell scripts must keep LF endings whatever the checkout platform does.
# With core.autocrlf=true a CRLF script fails with a "not found" error naming a
# command that plainly exists -- the hardest kind of breakage to read.
*.sh text eol=lf
start.command text eol=lf

# The demo assets are binary; never let them through line-ending conversion.
*.gif binary
*.mp4 binary
