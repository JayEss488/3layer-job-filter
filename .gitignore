# Secrets. Copy .env.example -> .env and fill in your own keys.
.env
frontend/.env.local

# Python
__pycache__/
*.pyc
venv/
.venv/

# Node
node_modules/
frontend/.next/
frontend/out/

# Everything the app GENERATES: the SQLite store (created on first boot), the
# engine's gate/rank cache, the CV scratch file and the raw discovery dump. All
# of it lands in one directory so a clean slate is `rm -rf data/`. Point DATA_DIR
# somewhere outside the repo to keep a test run's output away entirely; see
# data_paths.py.
data/

# Belt-and-braces: installs predating data/, and a DATA_DIR pointed back inside
# the repo. (Harness output has its own block further down.)
*.db
*.db-shm
*.db-wal
*.bak
raw_api_jobs.json
exp.txt

# Everything not part of the running app: archived prototypes, wireframes,
# design docs, ad-hoc analysis scripts, raw data samples, private documents.
# Kept on disk, never published. See archive/README.md.
archive/

# Diagnostic report output from tests/ and scripts/
tests/gate_reports/
tests/tier_reports/
tests/prompt_pipeline_reports/
tests/profile_formation_reports/
tests/medium_vs_strong_reports/
tests/judge_reports/

# Dev-only crawl cache for scripts/gen_uk_geo.py (the generated module is committed)
scripts/.uk_geo_crawl_cache.json
